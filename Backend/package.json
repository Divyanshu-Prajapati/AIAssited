{
  "name": "dsa-assessment-backend",
  "version": "1.0.0",
  "description": "Backend API service for DSA AI Assessment Lab",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/seed/seedRunner.ts",
    "validate:question-schema": "tsx src/scripts/validateQuestionSchema.ts",
    "validate:question-bank": "tsx src/scripts/validateQuestionBank.ts",
    "validate:all": "tsc --noEmit && tsx src/scripts/validateQuestionSchema.ts && tsx src/scripts/validateQuestionBank.ts && tsx src/test/runTests.ts",
    "test": "tsx src/test/runTests.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
