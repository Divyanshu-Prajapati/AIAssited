generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  name              String             @default("Candidate")
  email             String             @unique @default("candidate@dsa-lab.local")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  skillProfile      String             @default("{}")
  attempts          Attempt[]
  sessions          AssessmentSession[]
  skillProgresses   SkillProgress[]
}

model Question {
  id                      String              @id @default(uuid())
  title                   String
  story                   String
  problemStatement        String
  inputFormat             String
  outputFormat            String
  constraints             String
  examples                String
  difficulty              String
  topic                   String
  pattern                 String
  expectedTimeComplexity  String
  expectedSpaceComplexity String
  timeLimit               Int                 @default(2000)
  memoryLimit             Int                 @default(256)
  starterCode             String
  visibleTests            String
  hiddenTests             String
  edgeCases               String
  tags                    String
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  attempts                Attempt[]
  sessions                AssessmentSession[]
}

model AssessmentSession {
  id                 String          @id @default(uuid())
  userId             String
  questionId         String
  mode               String          @default("AI_ASSISTED")
  state              String          @default("PROBLEM_LOADED")
  startedAt          DateTime        @default(now())
  endedAt            DateTime?
  timeLimitMinutes   Int             @default(45)
  remainingSeconds   Int             @default(2700)
  currentCode        String
  understandingText  String          @default("")
  planText           String          @default("")
  implementationText String          @default("")
  generatedCode      String          @default("")
  promptQualityScore Float           @default(0)
  planQualityScore   Float           @default(0)
  hintsUsed          Int             @default(0)
  solutionRevealed   Boolean         @default(false)
  overallScore       Float           @default(0)
  evaluationReport   String          @default("{}")
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question           Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  aiInteractions     AIInteraction[]
  codeVersions       CodeVersion[]
  attempts           Attempt[]
}

model Attempt {
  id              String            @id @default(uuid())
  userId          String
  questionId      String
  sessionId       String
  startedAt       DateTime          @default(now())
  submittedAt     DateTime          @default(now())
  status          String
  score           Float
  executionTimeMs Int               @default(0)
  memoryKb        Int               @default(0)
  code            String
  hintsCount      Int               @default(0)
  evaluation      String            @default("{}")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session         AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  testResults     TestResult[]
}

model TestResult {
  id              String   @id @default(uuid())
  attemptId       String
  testType        String
  testIndex       Int
  passed          Boolean
  executionTimeMs Int      @default(0)
  memoryKb        Int      @default(0)
  expectedOutput  String
  actualOutput    String
  errorLog        String?
  attempt         Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model AIInteraction {
  id                String            @id @default(uuid())
  sessionId         String
  phase             String
  userPrompt        String
  assistantResponse String
  promptScore       Float             @default(0)
  feedbackType      String            @default("GENERAL")
  timestamp         DateTime          @default(now())
  session           AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model CodeVersion {
  id            String            @id @default(uuid())
  sessionId     String
  versionNumber Int
  code          String
  action        String
  testSummary   String            @default("")
  timestamp     DateTime          @default(now())
  session       AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SkillProgress {
  id            String   @id @default(uuid())
  userId        String
  topic         String
  score         Float    @default(0)
  attempts      Int      @default(0)
  solvedCount   Int      @default(0)
  successRate   Float    @default(0)
  lastPracticed DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
}
